{
  "name": "@omni-terminal/sdk",
  "version": "0.8.4",
  "description": "Public TypeScript SDK for Omni AI News, x402/MCP analytics, and direct Hyperliquid market data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brokers": {
      "types": "./dist/brokers/index.d.ts",
      "import": "./dist/brokers/index.js"
    }
  },
  "files": [
    "dist",
    "dist-examples",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.examples-build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --import tsx --test test/unit.test.ts test/boundary.test.ts test/agents.test.ts test/bundle-budget.test.ts test/x402-hardening.test.ts test/guarded-testnet.test.ts test/guarded-rejection.test.ts test/error-redaction.test.ts test/screenshots.test.ts test/guarded-runner.test.ts test/reconciliation-report.test.ts test/builder-attribution.test.ts test/paid-response-recovery.test.ts",
    "test:agents": "node --import tsx --test test/agents.test.ts",
    "test:examples": "npm run example:news-ws:demo && npm run example:agentic-flow:demo && npm run example:ask-omni:demo && npm run example:coinbase:demo && npm run example:robinhood:demo",
    "test:live": "node --import tsx --test test/live.test.ts",
    "test:boundary": "tsx scripts/verify-public-boundary.ts .",
    "test:docs": "tsx scripts/verify-docs.ts ../..",
    "test:package": "tsx scripts/verify-package.ts",
    "pack:check": "npm pack --dry-run --json",
    "verify": "npm run typecheck && npm test && npm run test:examples && npm run test:boundary && npm run test:docs && npm run test:package && npm audit --omit=dev",
    "verify:live": "npm run verify && npm run example:rest:public && npm run example:ws && npm run example:x402:free && npm run example:mcp:free && npm run test:live && npm run pack:check",
    "example:rest": "node --env-file-if-exists=.env dist-examples/rest-api-key.js",
    "example:rest:public": "node --env-file-if-exists=.env dist-examples/rest-api-key.js --public-only",
    "example:ws": "node --env-file-if-exists=.env dist-examples/ws-market.js",
    "example:news-ws": "node --env-file-if-exists=.env dist-examples/ws-news.js",
    "example:news-ws:demo": "node --env-file-if-exists=.env dist-examples/ws-news.js --demo",
    "example:x402": "node --env-file-if-exists=.env dist-examples/x402-all-routes.js",
    "example:x402:free": "node --env-file-if-exists=.env dist-examples/x402-all-routes.js --free-only",
    "example:mcp": "node --env-file-if-exists=.env dist-examples/mcp-all-tools.js",
    "example:mcp:free": "node --env-file-if-exists=.env dist-examples/mcp-all-tools.js --free-only",
    "example:ask-omni": "node --env-file-if-exists=.env dist-examples/agents/ask-omni-bundle.js",
    "example:ask-omni:demo": "node --env-file-if-exists=.env dist-examples/agents/ask-omni-bundle.js --demo",
    "example:agentic-flow:demo": "node --env-file-if-exists=.env dist-examples/agents/zero-to-one-demo.js",
    "example:coinbase": "node --env-file-if-exists=.env dist-examples/agents/coinbase-agent.js",
    "example:coinbase:demo": "node --env-file-if-exists=.env dist-examples/agents/coinbase-agent.js --demo",
    "example:robinhood": "node --env-file-if-exists=.env dist-examples/agents/robinhood-agent.js",
    "example:robinhood:demo": "node --env-file-if-exists=.env dist-examples/agents/robinhood-agent.js --demo",
    "example:guarded-execution": "node --env-file-if-exists=.env dist-examples/agents/guarded-execution.js",
    "example:reconciliation:free": "node --env-file-if-exists=.env dist-examples/agents/reconciliation-readonly.js",
    "example:research:free": "node --env-file-if-exists=.env dist-examples/agents/research-readonly.js --free-only",
    "example:guarded:preview": "node --env-file-if-exists=.env dist-examples/agents/guarded-execution.js --preview-only",
    "example:lifecycle:recovery": "node --env-file-if-exists=.env dist-examples/agents/lifecycle-recovery.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.46.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nktkas/hyperliquid": "0.33.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "@x402/mcp": "^2.20.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.37.13",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "omni-terminal",
    "hyperliquid",
    "x402",
    "mcp",
    "trading",
    "market-data"
  ],
  "license": "MIT",
  "sideEffects": false
}
