OMNI_API_URL=https://api.omniterminal.app
OMNI_APP_URL=https://omniterminal.app
OMNI_MCP_URL=https://omniterminal.app/api/x402/mcp
OMNI_WS_URL=wss://api.omniterminal.app
OMNI_API_KEY=
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# x402 buyer wallet. Use a separately funded, spending-limited wallet.
EVM_PRIVATE_KEY=
X402_MAX_PAYMENT_USD=0.01
X402_MAX_RESEARCH_SESSION_USD=0.013
RUN_PAID_EXAMPLES=false
RUN_PAID_RESEARCH=false
HL_ADDRESS=

# Broker examples remain dry-run unless LIVE_TRADING and the broker-specific
# confirmation are both set. Use COINBASE_LIVE_ORDER or ROBINHOOD_LIVE_ORDER.
LIVE_TRADING=false
CONFIRM_LIVE_ORDER=
MAX_ORDER_NOTIONAL_USD=25
TRADING_SYMBOL=BTC
# x402, mcp, or both. "both" buys Market Risk over REST plus Market Carry over native MCP.
OMNI_RESEARCH_TRANSPORT=both

# Coinbase App key name and ECDSA PEM secret. Escaped \n newlines are accepted.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Robinhood Crypto API key, base64 Ed25519 seed, and crypto account number.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_ACCOUNT_NUMBER=
