# This package hardcodes Hyperliquid testnet and refuses mainnet endpoints.
TESTNET_SYMBOL=BTC
TESTNET_MAX_NOTIONAL_USD=15
TESTNET_ORDER_OFFSET_BPS=200
TESTNET_MIN_CONFIDENCE=0.55

# A funded Hyperliquid testnet account or approved testnet API wallet is required
# only for the place -> verify -> cancel lifecycle test.
HL_TESTNET_PRIVATE_KEY=
HL_TESTNET_ACCOUNT_ADDRESS=
RUN_TESTNET_ORDERS=false
CONFIRM_TESTNET_ORDER=

# The Omni risk agent supports either paid x402 REST or paid MCP research.
OMNI_RESEARCH_TRANSPORT=x402
OMNI_APP_URL=https://omniterminal.app
OMNI_MCP_URL=https://omniterminal.app/api/x402/mcp
EVM_PRIVATE_KEY=
X402_MAX_PAYMENT_USD=0.01
RUN_PAID_RESEARCH=false
